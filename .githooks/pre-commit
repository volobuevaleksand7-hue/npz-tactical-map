#!/usr/bin/env bash
# NPZ TACTICAL MAP — pre-commit guard.
# Refuses any commit that would record git conflict / stash markers under data/.
# Enable with:  git config core.hooksPath .githooks
# (agents/git-sync.sh enables this automatically on first run.)
#
# It inspects the STAGED content (the index), not the working tree, so it catches
# exactly what is about to be committed.
set -uo pipefail

PROTECTED_UI_RE='^(index\.html|styles\.css|app\.js|radar\.html|version\.json|CHANGELOG\.md|\.vercelignore)$'
protected_ui="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E "$PROTECTED_UI_RE" || true)"
if [ -n "$protected_ui" ] && [ "${ALLOW_FRONTEND_RELEASE:-}" != "1" ]; then
  echo "pre-commit: BLOCKED — protected UI/release files are staged:" >&2
  printf '%s\n' "$protected_ui" | sed 's/^/    /' >&2
  echo "pre-commit: set ALLOW_FRONTEND_RELEASE=1 only for an intentional UI/release commit." >&2
  exit 1
fi

# ---- ЗОНЫ СЕССИЙ: не утаскивать чужую работу в свой коммит ----------------
# 🔴 01.08.2026: параллельная сессия сделала `git add -A` и утянула в свой коммит
# (04618a5f) незакоммиченную правку соседней сессии — фикс геокодера складов уехал
# под чужим сообщением, смысл в истории потерялся. В тот же день git-sync дважды
# снёс незакоммиченную работу. Оба раза корень один: сессии не знают друг о друге.
#
# Механика: сессия объявляет зону, создавая .claude/zones/<имя>.zone со списком
# glob-путей (по строке на путь). Хук блокирует коммит, если в индекс попал файл из
# ЧУЖОЙ свежей зоны (моложе ZONE_TTL_H часов). Свои зоны определяются переменной
# NPZ_ZONE (можно несколько через пробел).
#
# Осознанный компромисс: это ПРЕДУПРЕЖДЕНИЕ о пересечении, а не блокировка работы.
# Обход на один коммит: ALLOW_CROSS_ZONE=1 (например, когда правка реально общая).
ZONE_TTL_H="${NPZ_ZONE_TTL_H:-8}"
zone_dir=".claude/zones"
if [ -d "$zone_dir" ] && [ "${ALLOW_CROSS_ZONE:-}" != "1" ]; then
  staged_all="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
  if [ -n "$staged_all" ]; then
    now=$(date +%s)
    clash=""
    for zf in "$zone_dir"/*.zone; do
      [ -f "$zf" ] || continue
      zname="$(basename "$zf" .zone)"
      case " ${NPZ_ZONE:-} " in *" $zname "*) continue ;; esac   # своя зона
      # протухшую зону игнорируем: сессия давно закончилась, файл забыли убрать.
      # 🔴 GNU stat (Linux/VPS) первым: BSD-форма `stat -f %m` там НЕ ошибка, а другая
      # команда — печатает «  File: ...», и арифметика ниже падала под `set -u`
      # («File: unbound variable»), обваливая КАЖДЫЙ коммит на VPS. Плюс явная
      # проверка на число: любой неожиданный вывод трактуем как «зона протухла».
      # 🔴 Возраст зоны берём из git, а не из mtime файла: свежий `git worktree add`
      # штампует ВСЕ файлы временем чекаута, и зона трёхдневной давности выглядела
      # рождённой минуту назад. А работать субагентам предписано именно из worktree —
      # то есть guard блокировал любой их коммит навсегда (05.08: зоны от 02.08,
      # возрастом ~70 ч, считались живыми). mtime остаётся фолбэком для не-git случаев.
      zmod=$(git log -1 --format=%ct -- "$zf" 2>/dev/null)
      case "$zmod" in ''|*[!0-9]*) zmod=$(stat -c %Y "$zf" 2>/dev/null || stat -f %m "$zf" 2>/dev/null || echo 0) ;; esac
      case "$zmod" in ''|*[!0-9]*) zmod=0 ;; esac
      [ "$zmod" -eq 0 ] && continue
      [ $(( (now - zmod) / 3600 )) -ge "$ZONE_TTL_H" ] && continue
      while IFS= read -r pat; do
        [ -z "$pat" ] && continue
        case "$pat" in \#*) continue ;; esac
        hit="$(printf '%s\n' "$staged_all" | grep -E "$pat" || true)"
        # ${zname} в фигурных скобках обязателен: следом идёт многобайтовая «»», и bash
        # затягивал её в имя переменной — под `set -u` это «zname»: unbound variable»,
        # то есть сторож падал ровно в тот момент, когда должен был напечатать претензию.
        [ -n "$hit" ] && clash="$clash\n  зона «${zname}» ($pat):\n$(printf '%s\n' "$hit" | sed 's/^/      /')"
      done < "$zf"
    done
    if [ -n "$clash" ]; then
      echo "pre-commit: BLOCKED — в коммит попали файлы из ЧУЖОЙ активной зоны:" >&2
      printf "%b\n" "$clash" >&2
      echo "pre-commit: это защита от 'git add -A', который утаскивает работу соседней сессии." >&2
      echo "pre-commit: закоммить только своё (git add <файлы>), либо ALLOW_CROSS_ZONE=1, если правка общая." >&2
      exit 1
    fi
  fi
fi

# ---- ЦЕНЗОР СТАТЕЙ: нейтральность любой публикуемой страницы --------------
# До 22.07 фильтр стоял только на data/strikes.json: статью, написанную агентом,
# не проверял никто — она уезжала на сайт как есть. Стоит ВЫШЕ выхода по пустому
# $staged: коммит со статьями обычно не трогает data/, и блок бы не отработал.
# Эпитеты censor вычищает сам и перезакладывает файл (как sanitize-strikes);
# лозунг/призыв/укр-язык автоправкой не лечится — такой коммит блокируется.
# Осознанная публикация цитаты в разборе -> ALLOW_CENSOR_OVERRIDE=1.
if [ -f agents/censor.py ] && command -v python3 >/dev/null 2>&1 && [ "${ALLOW_CENSOR_OVERRIDE:-}" != "1" ]; then
  staged_html="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '\.html$' || true)"
  if [ -n "$staged_html" ]; then
    censor_rc=0
    # shellcheck disable=SC2086
    python3 agents/censor.py $staged_html >&2 || censor_rc=1
    for _f in $staged_html; do
      if [ -f "$_f" ] && ! git diff --quiet -- "$_f" 2>/dev/null; then
        git add "$_f"
        echo "pre-commit: censor нейтрализовал $_f и перезаложил его в коммит." >&2
      fi
    done
    if [ "$censor_rc" != "0" ]; then
      echo "pre-commit: BLOCKED — в статье лозунг/призыв/украинский язык (см. выше)." >&2
      echo "pre-commit: это не эпитет вокруг факта, автоматом не чинится — правь текст." >&2
      echo "pre-commit: осознанная цитата в разборе -> ALLOW_CENSOR_OVERRIDE=1." >&2
      exit 1
    fi
  fi
fi

# ---- cover-weight guard: сжать несжатые обложки перед деплоем (режет Fast Data Transfer) ----
# 24.07: cover-2026-07-23.png уехал 2.1 МБ и грузился на /news + в og:image при каждом просмотре —
# генератор обошёл optimize_cover-хук в caption_cover. Ловим ЛЮБОЙ путь здесь: сжимаем staged
# cover/analytics/og PNG на месте (×5-8) + обновляем webp-тумбу, перезакладываем. Идемпотентно
# (уже сжатые пропускаются). Стоит ВЫШЕ выхода по пустому data/ — обложки лежат в assets/.
if command -v python3 >/dev/null 2>&1; then
  staged_cov="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '^(assets/cover-.*\.png|assets/analytics-.*\.png|og-image\.png)$' || true)"
  for _c in $staged_cov; do
    [ -f "$_c" ] || continue
    python3 -c "import sys;sys.path.insert(0,'agents');from optimize_covers import optimize_cover,make_thumb;p=sys.argv[1];optimize_cover(p);('/cover-' in p.replace('\\\\','/')) and make_thumb(p)" "$_c" 2>/dev/null || true
    if ! git diff --quiet -- "$_c" 2>/dev/null; then
      git add "$_c"
      echo "pre-commit: обложка $_c сжата и перезаложена." >&2
    fi
    case "$_c" in
      assets/cover-*.png)
        _t="assets/thumb/$(basename "${_c%.png}").webp"
        [ -f "$_t" ] && git add "$_t" ;;
    esac
  done
fi

# ---- national-balance guard: headline-цифра выводится из таблицы, а не из модели ----
# 25.07: на главной висело «мощностей выбито полностью 64%» при 38.5% по собственным
# данным (агент записал в capacity_offline_* значение недобора 215.0/64% — другую
# метрику). Завышение в 1.7× на нейтральном OSINT-проекте. Тот же класс, что дрейф
# /refineries: две суммы считал LLM-агент на каждом синке и однажды перепутал поля.
# Пересчитываем детерминированно из refineries[] и перезакладываем (авто-фикс, как
# цензор/обложки: агент коммитит headless на VPS — блокировкой мы бы просто застопорили
# данные). Идемпотентно: если цифры сходятся, файл не трогается.
# Тем же вызовом (без --check) скрипт дописывает точку в data/capacity-timeline.json,
# если capacity_offline_pct изменился с последней сохранённой точки — иначе файл не
# трогает (этот файл до 25.07 никто не дописывал, панель «динамика выбытия» на главной
# застряла на 12.07). git add — на оба файла, второй может не измениться (idempotent).
if git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -q '^data/fuel-state\.json$' \
   && [ -f agents/recalc-national-balance.py ] && command -v python3 >/dev/null 2>&1; then
  # Один вызов чинит national_balance (если разошёлся) И дописывает точку таймлайна
  # (если процент изменился) — оба идемпотентны, лишний git add на неизменный файл
  # ничего не сделает.
  python3 agents/recalc-national-balance.py >&2 || true
  git diff --quiet -- data/fuel-state.json 2>/dev/null || git add data/fuel-state.json
  [ -f data/capacity-timeline.json ] && { git diff --quiet -- data/capacity-timeline.json 2>/dev/null || {
    git add data/capacity-timeline.json
    echo "pre-commit: capacity-timeline.json дописан и перезаложен." >&2
  }; }
fi

# Files staged for commit under data/ (added/copied/modified/renamed).
staged="$(git diff --cached --name-only --diff-filter=ACMR -- data/ 2>/dev/null)"
[ -z "$staged" ] && exit 0

bad=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  # Read the staged blob (not the working file) and look for conflict markers.
  if git show ":$f" 2>/dev/null | grep -nE '^(<<<<<<<|=======|>>>>>>>)' >/dev/null; then
    echo "pre-commit: BLOCKED — $f contains conflict/stash markers:" >&2
    git show ":$f" 2>/dev/null | grep -nE '^(<<<<<<<|=======|>>>>>>>)' | sed 's/^/    /' >&2
    bad=1
  fi
  # JSON parse guard: агенты клеят JSON руками → висячая запятая роняла Smoke test
  # (validate-json) на КАЖДОМ последующем коммите. Ловим битый JSON до пуша, а не в CI.
  case "$f" in
    *.json)
      if command -v python3 >/dev/null 2>&1 && ! git show ":$f" 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null; then
        echo "pre-commit: BLOCKED — $f не парсится как JSON:" >&2
        git show ":$f" 2>/dev/null | python3 -c 'import json,sys; json.load(sys.stdin)' 2>&1 | tail -1 | sed 's/^/    /' >&2
        bad=1
      fi ;;
  esac
done <<< "$staged"

if [ "$bad" = "1" ]; then
  echo "pre-commit: fix the marker(s) above and re-stage. Commit aborted." >&2
  exit 1
fi

# ---- archive-shrink guard: strikes.json — полный архив, коллекторы только дописывают ----
# Дважды (июнь: 168→110, 08.07: 147→5) облачный коллектор перезаписывал архив свежим
# снапшотом. Блокируем коммит, если число strikes падает >10%. Обход: ALLOW_STRIKES_SHRINK=1.
if echo "$staged" | grep -q '^data/strikes\.json$' && [ "${ALLOW_STRIKES_SHRINK:-}" != "1" ] && command -v python3 >/dev/null 2>&1; then
  old_n="$(git show HEAD:data/strikes.json 2>/dev/null | python3 -c 'import json,sys;print(len(json.load(sys.stdin).get("strikes",[])))' 2>/dev/null || echo 0)"
  new_n="$(git show :data/strikes.json 2>/dev/null | python3 -c 'import json,sys;print(len(json.load(sys.stdin).get("strikes",[])))' 2>/dev/null || echo 0)"
  if [ "$old_n" -gt 20 ] && [ "$new_n" -lt "$((old_n * 9 / 10))" ]; then
    echo "pre-commit: BLOCKED — data/strikes.json усыхает: $old_n → $new_n записей." >&2
    echo "pre-commit: strikes.json — ПОЛНЫЙ архив, коллекторы только дописывают." >&2
    echo "pre-commit: осознанная чистка → ALLOW_STRIKES_SHRINK=1." >&2
    exit 1
  fi
fi

# ---- archive-shrink guard: fuel-voices.json — накопительный архив голосов ----
# 15.07: 96 → 67 → 0. Обнулил НЕ сам fuel-voices: git-sync делает `git add data/` и сгребает
# пустой/недописанный файл с диска (обнуление прилетело в коммите data(radar)), а следующий
# прогон агента читает уже пустое и увековечивает. Здесь НЕ блокируем (в отличие от strikes):
# коммит с голосами делают и другие рутины, а radar тикает каждые 5 мин — блок заклинил бы
# публикацию. Вместо этого восстанавливаем архив из HEAD и перезакладываем — данные целы,
# конвейер жив. Осознанная чистка → ALLOW_VOICES_SHRINK=1.
if echo "$staged" | grep -q '^data/fuel-voices\.json$' && [ "${ALLOW_VOICES_SHRINK:-}" != "1" ] && command -v python3 >/dev/null 2>&1; then
  v_old="$(git show HEAD:data/fuel-voices.json 2>/dev/null | python3 -c 'import json,sys;print(len(json.load(sys.stdin).get("voices",[])))' 2>/dev/null || echo 0)"
  v_new="$(git show :data/fuel-voices.json 2>/dev/null | python3 -c 'import json,sys;print(len(json.load(sys.stdin).get("voices",[])))' 2>/dev/null || echo 0)"
  if [ "$v_old" -gt 20 ] && [ "$v_new" -lt "$((v_old * 9 / 10))" ]; then
    if git show HEAD:data/fuel-voices.json > data/fuel-voices.json 2>/dev/null; then
      git add data/fuel-voices.json
      echo "pre-commit: fuel-voices.json усыхал ($v_old → $v_new голосов) — АРХИВ ВОССТАНОВЛЕН из HEAD и перезаложен." >&2
      echo "pre-commit: осознанная чистка → ALLOW_VOICES_SHRINK=1." >&2
    fi
  fi
fi

# ---- coverage guard: fuel-availability.json — регионы не должны пропадать ----
# 27.07: агент отдал 13 регионов вместо 88 → 6131 АЗС посерели на 4 суток. 30.07 повторилось
# (24 вместо 86): плохая версия упёрлась в конфликт и заклинила git-sync на 13 часов — rebase
# встал на шаге 18/72, флот коммитил в пустоту. Промпт агента ОБЕЩАЕТ «покрытие не
# уменьшается», но валидатор в цепочке не вызывается: обещание в тексте ≠ страж в конвейере.
# НЕ блокируем (как fuel-voices, и ровно по той причине, что стоила 13 часов простоя): файл
# едет в общем коммите git-sync вместе с радаром, exit 1 остановил бы публикацию целиком.
# Логика доклейки — agents/guard-availability-coverage.py (есть --selfcheck).
if echo "$staged" | grep -q '^data/fuel-availability\.json$' && [ "${ALLOW_COVERAGE_DROP:-}" != "1" ] \
   && [ -f agents/guard-availability-coverage.py ] && command -v python3 >/dev/null 2>&1; then
  _fa_msg="$(python3 agents/guard-availability-coverage.py 2>/dev/null || true)"
  if [ -n "$_fa_msg" ]; then
    git add data/fuel-availability.json
    echo "pre-commit: $_fa_msg" >&2
    echo "pre-commit: осознанное сокращение → ALLOW_COVERAGE_DROP=1." >&2
  fi
fi

# ---- neutral-OSINT guard: вычистить пропаганду / укр-вербатим / офф-топик из strikes ----
# Ловит ЛЮБОЙ коммит (newswatch, ручной, внешняя модель), т.к. core.hooksPath=.githooks.
# Санитайзер идемпотентен и авто-перезакладывает очищенный файл — коммит не блокируется,
# но мусор физически не попадает в data/strikes.json (и на сайт/в Telegram).
if [ -f agents/sanitize-strikes.py ] && command -v python3 >/dev/null 2>&1; then
  for _f in data/strikes.json data/history-crimea.json; do
    if echo "$staged" | grep -q "^$_f$"; then
      python3 agents/sanitize-strikes.py "$_f" >&2 || true
      if ! git diff --quiet -- "$_f" 2>/dev/null; then
        git add "$_f"
        echo "pre-commit: sanitize-strikes очистил $_f и перезаложил его в коммит." >&2
      fi
    fi
  done
fi

# ---- future-dates guard: событие не может произойти позже момента записи ----
# 15.07 агент записал удар по Балаклавской ТЭС как «15.07 23:10», когда было 13:44 МСК
# (реально — ночь на 14.07). Модель текущего времени не знает и берёт дату из головы.
# Метаполя (generated_at) скрипт чинит сам и молча; запись из будущего — БЛОКИРУЕТ:
# правильного времени мы не знаем, а угадать = подделать. Удалять запись тоже нельзя
# (усыхание архива). Осознанный бэкфилл → ALLOW_FUTURE_DATES=1.
# Идёт ПОСЛЕ санитайзера: тот перезакладывает файл, проверять надо итог.
if [ -f agents/check-future-dates.py ] && command -v python3 >/dev/null 2>&1; then
  for _f in data/strikes.json data/history-crimea.json; do
    if echo "$staged" | grep -q "^$_f$"; then
      if ! python3 agents/check-future-dates.py "$_f" >&2; then
        echo "pre-commit: BLOCKED — даты из будущего в $_f (см. выше). Commit aborted." >&2
        exit 1
      fi
      if ! git diff --quiet -- "$_f" 2>/dev/null; then
        git add "$_f"
        echo "pre-commit: check-future-dates поправил метку времени в $_f." >&2
      fi
    fi
  done
fi
exit 0
